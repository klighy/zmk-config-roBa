+static void send_layer_state_report_callback(struct k_work *work) {
+    const struct bt_gatt_attr *attr = NULL;
+    for (size_t i = 0; i < hog_svc.attr_count; i++) {
+        if (hog_svc.attrs[i].read == read_hids_layer_state_report) {
+            attr = &hog_svc.attrs[i];
+            break;
+        }
+    }
+    if (!attr) {
+        return;
+    }
+
+    struct zmk_hid_layer_state_report_body report;
+    while (k_msgq_get(&zmk_hog_layer_state_msgq, &report, K_NO_WAIT) == 0) {
+        struct bt_conn *conn = zmk_ble_active_profile_conn();
+        if (!conn) {
+            continue;
+        }
+        struct bt_gatt_notify_params params = {
+            .attr = attr,
+            .data = &report,
+            .len = sizeof(report),
+        };
+        int err = bt_gatt_notify_cb(conn, &params);
+        if (err == -EPERM) {
+            bt_conn_set_security(conn, BT_SECURITY_L2);
+        } else if (err) {
+            LOG_DBG("Error notifying layer state: %d", err);
+        }
+        bt_conn_unref(conn);
+    }
+}
+
+K_WORK_DEFINE(hog_layer_state_work, send_layer_state_report_callback);
+
+int zmk_hog_send_layer_state_report(struct zmk_hid_layer_state_report_body *report) {
+    int err = k_msgq_put(&zmk_hog_layer_state_msgq, report, K_NO_WAIT);
+    if (err) {
+        struct zmk_hid_layer_state_report_body discarded;
+        k_msgq_get(&zmk_hog_layer_state_msgq, &discarded, K_NO_WAIT);
+        err = k_msgq_put(&zmk_hog_layer_state_msgq, report, K_NO_WAIT);
+    }
+    k_work_submit_to_queue(&hog_work_q, &hog_layer_state_work);
+    return err;
+}
+#endif
 
