+    DT_INST_FOREACH_CHILD_SEP(0, LAYER_NAME, (, ))};
+
+static uint32_t changed_layer_names = 0;
+
+#else
+
+static const char *zmk_keymap_layer_names[ZMK_KEYMAP_LAYERS_LEN] = {
+    DT_INST_FOREACH_CHILD_SEP(0, LAYER_NAME, (, ))};
+
+#endif
+
+#if ZMK_KEYMAP_HAS_SENSORS
+
+static struct zmk_behavior_binding
