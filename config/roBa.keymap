#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define LAYER_WIN     0
#define LAYER_MAC     1
#define LAYER_CAL     2
#define LAYER_NUM     3
#define LAYER_ARROW   4
#define LAYER_MOUSE   5
#define LAYER_SCROLL  6
#define LAYER_SETTING 7

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <LAYER_MOUSE>;
    scroll-layers = <LAYER_SCROLL>;

    // arrows {
    //     layers = <LAYER_ARROW>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <1 2>;
        };

        IMEoff {
            bindings = <&kp LANG2>;
            key-positions = <12 13>;
        };

        IMEon {
            bindings = <&kp LANG1>;
            key-positions = <18 19>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <8 7>;
        };

        setting {
            bindings = <&tog 7>;
            key-positions = <34 42>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        encoder_scroll: encoder_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;

            // Emit 16 high-resolution units (one wheel step) per 16 ms tick.

            tap-ms = <24>;
            bindings = <&msc MOVE_Y(-1024)>, <&msc MOVE_Y(1024)>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        sc: sc {
            compatible = "zmk,behavior-mod-morph";
            label = "SC";
            bindings = <&kp COMMA>, <&kp SEMICOLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        sp: sp {
            compatible = "zmk,behavior-mod-morph";
            label = "SP";
            bindings = <&kp PERIOD>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        sb: sb {
            compatible = "zmk,behavior-mod-morph";
            label = "SB";
            bindings = <&kp SPACE>, <&kp BACKSPACE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        qe: qe {
            compatible = "zmk,behavior-mod-morph";
            label = "QE";
            bindings = <&kp QUESTION>, <&kp EXCLAMATION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        line: line {
            compatible = "zmk,behavior-mod-morph";
            label = "LINE";
            bindings = <&kp MINUS>, <&kp PIPE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        SBlash: SBlash {
            compatible = "zmk,behavior-mod-morph";
            label = "SBLASH";
            bindings = <&kp KP_SLASH>, <&kp BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        gtlt: gtlt {
            compatible = "zmk,behavior-mod-morph";
            label = "GTLT";
            bindings = <&kp GREATER_THAN>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_win {
            display-name = "WIN";
            bindings = <
&kp Q      &kp W         &kp E         &kp R        &kp T                                                 &kp Y        &kp U  &kp I  &kp O  &kp P
&kp A      &kp S         &kp D         &kp F        &kp G        &mkp MB3                  &kp EQUAL      &kp H        &kp J  &kp K  &kp L  &kp SINGLE_QUOTE
&kp Z      &kp X         &kp C         &kp V        &kp B        &kp GRAVE                 &kp MINUS      &kp N        &kp M  &sc    &sp    &kp SLASH
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &lt 3 LANG2  &lt 6 LANG1  &mt LEFT_SHIFT SPACE      &kp BACKSPACE  &lt 2 ENTER                       &kp BACKSLASH
            >;

            sensor-bindings = <&encoder_scroll>;
        };

        dafault_mac {
            display-name = "MAC";
            bindings = <
&trans            &trans     &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans            &trans     &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans            &trans     &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_COMMAND  &kp LCTRL  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        CAL {
            display-name = "CAL";
            bindings = <
&trans        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans                                  &kp KP_EQUAL  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER      &trans
&kp KP_SLASH  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MINUS  &trans      &kp SLASH     &kp ASTERISK  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LESS_THAN  &kp GREATER_THAN
&kp ASTERISK  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_PLUS   &trans      &kp KP_MINUS  &kp KP_PLUS   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans         &trans
&kp LANG2     &kp N0        &kp PERIOD    &trans        &kp KP_EQUAL  &trans      &trans        &trans                                                                    &kp LANG1
            >;
        };

        NUM {
            display-name = "NUM";
            bindings = <
&kp MINUS  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                                   &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))      &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&trans     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL                    &kp PIPE        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&kp LANG2  &kp KP_NUMBER_0  &kp PERIOD       &trans           &trans        &trans                       &trans          &trans                                                                     &kp LANG1
            >;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &mo 5
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB4  &trans    &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            display-name = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        ARROW {
            display-name = "ARROW";
            bindings = <
&kp ESCAPE  &kp LC(LS(TAB))  &kp UP_ARROW    &kp LC(TAB)      &trans                       &trans  &kp LA(LC(LEFT_ARROW))  &kp LC(UP_ARROW)    &kp LC(LA(RIGHT_ARROW))  &trans
&kp HOME    &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END  &trans      &trans  &trans  &kp LC(LEFT_ARROW)      &kp LC(DOWN_ARROW)  &kp LC(RIGHT_ARROW)      &trans
&trans      &trans           &trans          &trans           &trans   &trans      &trans  &trans  &trans                  &trans              &trans                   &trans
&trans      &trans           &trans          &trans           &trans   &trans      &trans  &trans                                                                       &trans
            >;
        };

        setting {
            display-name = "SETTING";
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &tog 1        &trans        &trans        &bt BT_CLR    &bt BT_CLR_ALL
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &trans
            >;
        };
    };
};
